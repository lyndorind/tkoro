{
  "info": {
    "name": "Lab 7 — PostgreSQL API integration",
    "description": "Runs against FastAPI and a real PostgreSQL service container in GitHub Actions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "noteId", "value": "", "type": "string" },
    { "key": "noteText", "value": "Lab 7 — Newman PostgreSQL integration", "type": "string" }
  ],
  "item": [
    {
      "name": "01 Healthcheck returns 200",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [{ "listen": "test", "script": {
        "type": "text/javascript", "exec": [
          "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
          "pm.test('Service is healthy', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
        ]
      }}]
    },
    {
      "name": "02 Create note in PostgreSQL",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"text\":\"{{noteText}}\"}" },
        "url": "{{baseUrl}}/notes"
      },
      "event": [{ "listen": "test", "script": {
        "type": "text/javascript", "exec": [
          "pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });",
          "const note = pm.response.json();",
          "pm.test('Note has ID and original text', function () { pm.expect(note.id).to.be.a('number'); pm.expect(note.text).to.eql(pm.collectionVariables.get('noteText')); });",
          "pm.collectionVariables.set('noteId', String(note.id));"
        ]
      }}]
    },
    {
      "name": "03 Read the new note back from PostgreSQL",
      "request": { "method": "GET", "url": "{{baseUrl}}/notes/{{noteId}}" },
      "event": [{ "listen": "test", "script": {
        "type": "text/javascript", "exec": [
          "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
          "const note = pm.response.json();",
          "pm.test('Database preserved the ID and text', function () { pm.expect(String(note.id)).to.eql(pm.collectionVariables.get('noteId')); pm.expect(note.text).to.eql(pm.collectionVariables.get('noteText')); });"
        ]
      }}]
    },
    {
      "name": "04 Unknown note returns 404",
      "request": { "method": "GET", "url": "{{baseUrl}}/notes/2147483647" },
      "event": [{ "listen": "test", "script": {
        "type": "text/javascript", "exec": [
          "pm.test('HTTP 404 Not Found', function () { pm.response.to.have.status(404); });"
        ]
      }}]
    },
    {
      "name": "05 Empty note is rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"text\":\"\"}" },
        "url": "{{baseUrl}}/notes"
      },
      "event": [{ "listen": "test", "script": {
        "type": "text/javascript", "exec": [
          "pm.test('HTTP 422 Unprocessable Entity', function () { pm.response.to.have.status(422); });"
        ]
      }}]
    }
  ]
}
